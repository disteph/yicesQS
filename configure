#!/bin/sh

set -eu

profile=
static=0

usage() {
  cat <<EOF
Usage: ./configure [--debug | --static]

Options:
  --debug    Build with dune profile debug.
  --static   Build with dune profile static and verify the executable is static.
  --help     Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --debug)
      if [ "$static" = "1" ]; then
        echo "configure: --debug and --static are mutually exclusive" >&2
        exit 1
      fi
      profile=debug
      ;;
    --static)
      if [ "$profile" = "debug" ]; then
        echo "configure: --debug and --static are mutually exclusive" >&2
        exit 1
      fi
      profile=static
      static=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "configure: unknown option $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

cat > config.mk <<EOF
# Generated by ./configure; do not edit.
DUNE_PROFILE := $profile
YICESQS_STATIC := $static
EOF

echo "Configured yicesQS:"
if [ -n "$profile" ]; then
  echo "  DUNE_PROFILE=$profile"
else
  echo "  DUNE_PROFILE=<default>"
fi
echo "  YICESQS_STATIC=$static"
echo
echo "Run 'make' to build."
